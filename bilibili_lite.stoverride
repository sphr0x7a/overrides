name: |-
  BiliBili 去廣告
desc: |-
  過濾 BiliBili 廣告
icon: |-
  https://fastly.jsdelivr.net/gh/fmz200/wool_scripts/icons/apps/BiliBili.png
category: |-
  去廣告
http:
  mitm:
    - "app.bilibili.com"
  url-rewrite:
    - >-
      ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/show - reject-200
  script:
    - match: ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list
      name: "bilibili.ads_7"
      type: response
      require-body: true
      max-size: -1
      timeout: 60
    - match: ^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?
      name: "bilibili.ads_7"
      type: response
      require-body: true
      max-size: -1
      timeout: 60
    - match: ^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index
      name: "bilibili.ads_7"
      type: response
      require-body: true
      max-size: -1
      timeout: 60
    - match: ^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/tab
      name: "bilibili.ads_7"
      type: response
      require-body: true
      max-size: -1
      timeout: 60
    - match: ^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine
      name: "bilibili.ads_7"
      type: response
      require-body: true
      max-size: -1
      timeout: 60
    - match: ^https?:\/\/app\.bilibili\.com\/x\/resource\/top\/activity
      name: "bilibili.ads_7"
      type: response
      require-body: true
      max-size: -1
      timeout: 60
    - match: ^https?:\/\/app\.bilibili\.com\/x\/v2\/search\/square
      name: "bilibili.ads_7"
      type: response
      require-body: true
      max-size: -1
      timeout: 60
script-providers:
  "bilibili.ads_7":
    url: https://ddgksf2013.top/scripts/bilibili.ads.js
    interval: 86400