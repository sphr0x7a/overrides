name: |-
  墨跡天氣解鎖VIP
desc: |-
  解鎖墨跡天氣VIP
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MojiWeather.png
category: |-
  去廣告
http:
  mitm:
    - "*.api.moji.com"
  script:
    - match: ^https?:\/\/.*\.api\.moji\.com\/(sns\/json\/profile\/get_info_.+|json\/member_new\/homepage_info.+|user\/personal\/json\/profile_.+|flycard\/novice|shortvideo\/.+)
      name: "mojitianqi_8"
      type: response
      require-body: true
      max-size: -1
      timeout: 60
script-providers:
  "mojitianqi_8":
    url: https://raw.githubusercontent.com/chxm1023/Rewrite/main/mojitianqi.js
    interval: 86400
