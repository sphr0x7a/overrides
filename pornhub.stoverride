name: |-
  Pornhub 去廣告
desc: |-
  過濾 Pornhub 去廣告
icon: |-
  https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Pornhub.png
category: |-
  去廣告
http:
  mitm:
    - "cn.pornhub.com"
    - "www.pornhub.com"
  url-rewrite:
    - >-
      ^https?:\/\/(cn|www)\.pornhub\.com\/_xa\/ads - reject-dict
  script:
    - match: ^https?:/\/(cn|www)\.pornhub\.com\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf)))))
      name: "pornhub.ads_7"
      type: response
      require-body: true
      max-size: -1
      timeout: 60
script-providers:
  "pornhub.ads_7":
    url: https://ddgksf2013.top/scripts/pornhub.ads.js
    interval: 86400

